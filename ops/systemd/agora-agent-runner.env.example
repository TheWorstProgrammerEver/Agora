# Public runner configuration only. Never place the Agora agent key or another
# credential in this file. The key is available solely through
# LoadCredentialEncrypted=agora-agent-key and CREDENTIALS_DIRECTORY.
AGORA_RUNNER_API_URL=https://example.supabase.co/functions/v1/agora
AGORA_RUNNER_SUPABASE_URL=https://example.supabase.co
AGORA_RUNNER_SUPABASE_PUBLISHABLE_KEY=example-public-project-key
AGORA_RUNNER_CODEX_BIN=/home/my-user/.local/bin/codex
